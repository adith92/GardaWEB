# EXAMPLE ONLY. Never commit real values; use a local secret manager.
GARDA_VIEWER_TOKEN=<unique-minimum-24-character-secret>
GARDA_OPERATOR_TOKEN=<different-unique-minimum-24-character-secret>
GARDA_ADMIN_TOKEN=<another-unique-minimum-24-character-secret>
GARDA_CLEARCAM_TOKEN=<separate-clearcam-webhook-secret>
GARDA_DATA_KEY=<Fernet.generate_key().decode() output>
GARDA_CAMERAS_FILE=cameras.example.json
GARDA_DB_PATH=data/garda-vision.sqlite3
GARDA_CAM01_RTSP=<rtsp-url-in-private-env-only>
GARDA_CAM01_ONVIF_USER=<camera-username>
GARDA_CAM01_ONVIF_PASS=<camera-password>
GARDA_FACE_ID_ENABLED=0
GARDA_CONTRACT_BUNDLE=basic
# GARDA_PLATE_ONNX=<path-to-licensed-yolov8-single-class-plate-detector.onnx>
# GARDA_FACE_ONNX=<path-to-licensed-and-validated-arcface-onnx-model>

# OFF by default. Admin-only opt-in LAN scanning; never expose service publicly.
GARDA_NETWORK_SCAN_ENABLED=0
# Optional stricter allowlist, e.g. local private subnet (not your live network IP in Git):
# GARDA_SCAN_ALLOWED_CIDRS=192.168.50.0/24
