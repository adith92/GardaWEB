# Copy to infra/basic-v1/.env. Never commit any real secrets or camera URLs.
POSTGRES_USER=garda
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
POSTGRES_DB=garda
GARDA_ADMIN_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
GARDA_CAMERA_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
MEDIAMTX_API_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_SECRET
# Development only. Production: mount dedicated disk, e.g. /srv/garda/recordings.
GARDA_RECORDINGS_DIR=./data/recordings
